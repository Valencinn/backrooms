// Reglas de acceso del archivo SEÑAL 88; se despliegan en Firebase, no en Next.js.
// Cada usuario solo puede leer o modificar sus propios documentos autenticados.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Evidencias: el id del documento y userId deben corresponder a la sesión.
    match /progress/{userId} {
      allow read, delete: if request.auth != null
        && request.auth.uid == userId;

      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.userId == request.auth.uid;
    }

    // Perfil: permite lectura y guardado del propio usuario, sin acceso a perfiles ajenos.
    match /users/{userId} {
      allow read: if request.auth != null
        && request.auth.uid == userId;

      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.userId == request.auth.uid;
    }
  }
}
